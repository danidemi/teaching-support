#!/usr/bin/env bash
# Single entry point for the knowledge-graph editor. Everything runs in the container built from
# this directory, so the host needs nothing but Docker — same invocation shape as
# tools/slides/slides.
#
#   graph build             build/rebuild the container image
#   graph edit  <file>      start the server + dev UI, open a browser, edit <file>
#   graph check <file>...   run tools/graph/check.mjs (schema + closure check) headless
#   graph shell              interactive shell in the image, for debugging
#
# node_modules is not baked into the image (see Dockerfile) — the repo is bind-mounted, so the
# first `edit`/`check` run installs dependencies onto the host, owned by the invoking user; later
# runs reuse them.
set -euo pipefail

IMAGE="piattaforma-corsi/graph:1"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/../.." && pwd)"

die() { printf 'graph: %s\n' "$*" >&2; exit 2; }

have_image() { docker image inspect "$IMAGE" >/dev/null 2>&1; }

build_image() {
    printf 'building %s\n' "$IMAGE"
    docker build -t "$IMAGE" "$HERE"
}

ensure_image() {
    have_image || build_image
}

# Turn a host path into one relative to the repo root — what GRAPH_FILE/check.mjs expect, and
# what stays valid once re-rooted at /work inside the container.
rel() {
    local p="$1"
    if [[ "$p" == /* ]]; then
        printf '%s\n' "${p#"$REPO"/}"
    else
        printf '%s\n' "$(realpath --relative-to="$REPO" "$p")"
    fi
}

# Flags shared by every `docker run` below: bind-mount the repo, run as the invoking user (so
# files written back — the graph itself, node_modules on first run — are owned by you, not
# root), CWD at tools/graph. Kept as an array, not a function wrapping the whole command, because
# docker flags and the container's own command both have to come after this and mixing the two
# into one arg list makes docker misparse the image name (`docker run --rm node check.mjs ...`
# picks up the public "node" image instead of ours, since docker treats the first bare word after
# its own flags as the image).
common_flags=(
    -u "$(id -u):$(id -g)"
    -v "$REPO:/work"
    -w /work/tools/graph
    -e HOME=/tmp
)

ensure_deps() {
    ensure_image
    if [[ ! -d "$HERE/node_modules" ]]; then
        printf 'installing dependencies (first run, needs network)\n'
        docker run --rm "${common_flags[@]}" "$IMAGE" npm install
    fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
    build) build_image ;;

    edit)
        [[ $# -gt 0 ]] || die "edit needs a graph file"
        ensure_deps
        file="$(rel "$1")"
        cname="graph-edit-$$"
        printf 'serving %s at http://127.0.0.1:5173 (ctrl-c to stop)\n' "$file"
        # No -it: this runs backgrounded (see `wait "$cpid"` below) so there is no terminal to
        # attach a pty to. Not needed anyway — this is just log output, and docker still proxies
        # SIGINT to the container by default, so ctrl-c stops it either way.
        docker run --rm --name "$cname" "${common_flags[@]}" \
            -p 127.0.0.1:5173:5173 \
            -p 127.0.0.1:3001:3001 \
            -e GRAPH_FILE="$file" \
            -e GRAPH_SERVER_HOST=0.0.0.0 \
            "$IMAGE" sh docker/edit-entrypoint.sh &
        cpid=$!
        trap 'docker stop "$cname" >/dev/null 2>&1 || true' EXIT
        # Best-effort browser launch once Vite has had a moment to come up — not required, the
        # URL above is printed either way.
        (
            sleep 2
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open http://127.0.0.1:5173 >/dev/null 2>&1 || true
            elif command -v open >/dev/null 2>&1; then
                open http://127.0.0.1:5173 || true
            fi
        ) &
        wait "$cpid"
        ;;

    check)
        [[ $# -gt 0 ]] || die "check needs at least one graph file"
        ensure_deps
        files=()
        for f in "$@"; do files+=("/work/$(rel "$f")"); done
        docker run --rm "${common_flags[@]}" "$IMAGE" node check.mjs "${files[@]}"
        ;;

    shell) ensure_deps; docker run --rm -it "${common_flags[@]}" "$IMAGE" bash ;;
    # (shell keeps -it: it's run in the foreground, directly attached to a real terminal.)

    ""|-h|--help|help)
        sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;

    *) die "unknown command '$cmd' (try: graph help)" ;;
esac
